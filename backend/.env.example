# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/civicpulse
DB_USERNAME=root
DB_PASSWORD=REPLACE_WITH_YOUR_MYSQL_PASSWORD

# JWT Configuration (minimum 32 characters)
JWT_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_OR_BASE64_SECRET
JWT_EXPIRATION_MS=86400000

# Initial Municipal Administrator Bootstrap (used only if no admin exists)
ADMIN_EMAIL=admin@civicpulse.gov
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# CORS & Storage
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=uploads
PORT=8080
