# ==============================================================================
# CivicPulse Backend — Environment Configuration Reference
# ==============================================================================
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT.
# FOR PRODUCTION (RENDER), CONFIGURE THESE IN THE RENDER DASHBOARD ENVIRONMENT TAB.
# NEVER COMMIT REAL PASSWORDS OR CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Security Mode
# ------------------------------------------------------------------------------
# Set to 'prod' for production deployment to activate security validations
SPRING_PROFILES_ACTIVE=prod
REQUIRE_SECURE_ADMIN_PASSWORD=true

# Demo Data Toggle:
# Set to 'true' only for intentional evaluator/hackathon demonstration.
# WARNING: When true, a predictable demo citizen (citizen@civicpulse.org) is active.
# Set to 'false' for clean production deployment with zero mock data.
SEED_SAMPLE_DATA=true

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# Local MySQL 8:
# DB_URL=jdbc:mysql://localhost:3306/civicpulse?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=your_local_password

# TiDB Cloud Serverless (Production):
DB_URL=jdbc:mysql://gateway01.us-east-1.prod.aws.tidbcloud.com:4000/civicpulse?useSSL=true&requireSSL=true&enabledTLSProtocols=TLSv1.2,TLSv1.3&serverTimezone=UTC&useServerPrepStmts=true&cachePrepStmts=true&prepStmtCacheSqlLimit=10000&prepStmtCacheSize=1000&rewriteBatchedStatements=true
DB_USERNAME=your_cluster_prefix.root
DB_PASSWORD=your_tidb_cloud_password

# Schema management:
# 'validate' for pre-initialized TiDB Cloud database (via schema-tidb.sql)
# 'update' for automated first-boot table creation
JPA_DDL_AUTO=validate
SQL_INIT_MODE=never

# ------------------------------------------------------------------------------
# 3. JWT Authentication (HMAC-SHA256)
# ------------------------------------------------------------------------------
# Must be at least 32 characters (256 bits) long. Generate with: openssl rand -base64 32
JWT_SECRET=ReplaceWithAStrongSecretKeyAtLeast32CharactersLongForHMACSHA256
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 4. Initial Municipal Administrator Bootstrap
# ------------------------------------------------------------------------------
# Auto-created on first application launch if no admin account exists in database.
# In production, ADMIN_PASSWORD is REQUIRED, must be at least 16 characters long,
# and CANNOT be the default development password. You must provide your own unique secret.
ADMIN_EMAIL=admin@civicpulse.gov
# ADMIN_PASSWORD=your_custom_secure_password_min_16_chars

# ------------------------------------------------------------------------------
# 5. Server Port & CORS
# ------------------------------------------------------------------------------
# Render dynamically provides the PORT variable (default 8080).
PORT=8080

# Comma-separated list of allowed frontend origins. Supports wildcard patterns.
CORS_ALLOWED_ORIGINS=https://civicpulse.vercel.app,https://*.vercel.app,http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 6. File Upload Storage
# ------------------------------------------------------------------------------
UPLOAD_DIR=uploads
