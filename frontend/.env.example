# ==============================================================================
# CivicPulse Frontend — Environment Configuration Reference
# ==============================================================================
# For local development:
# Leave VITE_API_BASE_URL empty to use Vite's local proxy to http://localhost:8080.
#
# For production (Vercel):
# Set VITE_API_BASE_URL in Vercel Project Settings -> Environment Variables
# Example: https://civicpulse-backend-pill.onrender.com (without trailing slash)
# ==============================================================================
VITE_API_BASE_URL=https://civicpulse-backend-pill.onrender.com
