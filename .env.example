# ==============================================================================
# CivicPulse V2 — Environment Configuration Reference
# ==============================================================================
# This template outlines all environment variables required to run CivicPulse.
# Copy this file or use the dedicated backend/.env and frontend/.env files.
# NEVER commit real credentials, passwords, or production keys to version control.
# ==============================================================================

# --- Database Configuration (MySQL 8) ---
DB_URL=jdbc:mysql://localhost:3306/civicpulse?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD_HERE

# --- JWT Authentication (HMAC-SHA256, minimum 32 characters) ---
JWT_SECRET=ReplaceWithAStrongSecretKeyAtLeast32CharactersLongForHMACSHA256
JWT_EXPIRATION_MS=86400000

# --- Initial Municipal Administrator Bootstrap ---
# Automatically seeded upon first launch if no admin account exists
ADMIN_EMAIL=admin@civicpulse.gov
ADMIN_PASSWORD=Admin@12345

# --- Server Ports & CORS ---
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=uploads

# --- Frontend API Base URL ---
# Empty string for local development (uses Vite proxy to http://localhost:8080).
# Set to the deployed backend URL when deploying frontend independently (e.g., on Vercel).
VITE_API_BASE_URL=
