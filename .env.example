# ==============================================================================
# CivicPulse V2 — Full Stack Environment Configuration Reference
# ==============================================================================
# Production Deployment Targets (All 100% Free Tiers):
# - Database: TiDB Cloud Serverless (MySQL 8 compatible)
# - Backend:  Render Free Web Service (Docker / Java 25)
# - Frontend: Vercel Free Hobby Plan (React 19 / Vite SPA)
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend & Database Configuration (Set in Render Dashboard)
# ------------------------------------------------------------------------------
# Activate production profile and password validation:
SPRING_PROFILES_ACTIVE=prod
REQUIRE_SECURE_ADMIN_PASSWORD=true

# Demo Data Seeding Toggle:
# Set to 'true' only for intentional evaluator/hackathon demonstration.
# WARNING: When true, a predictable demo citizen (citizen@civicpulse.org) is active.
# Set to 'false' for clean production deployment with zero mock data.
SEED_SAMPLE_DATA=true

# TiDB Cloud Serverless JDBC connection URL with required TLS parameters:
DB_URL=jdbc:mysql://gateway01.us-east-1.prod.aws.tidbcloud.com:4000/civicpulse?useSSL=true&requireSSL=true&enabledTLSProtocols=TLSv1.2,TLSv1.3&serverTimezone=UTC&useServerPrepStmts=true&cachePrepStmts=true&prepStmtCacheSqlLimit=10000&prepStmtCacheSize=1000&rewriteBatchedStatements=true
DB_USERNAME=your_cluster_prefix.root
DB_PASSWORD=your_tidb_cluster_password

# Database schema management:
JPA_DDL_AUTO=validate
SQL_INIT_MODE=never

# JWT Secret (HMAC-SHA256, minimum 32 characters):
JWT_SECRET=ReplaceWithAStrongSecretKeyAtLeast32CharactersLongForHMACSHA256
JWT_EXPIRATION_MS=86400000

# Initial Municipal Administrator Account (Created automatically on first launch):
# In production, ADMIN_PASSWORD is required, must be at least 16 characters long,
# and cannot be the default development password. You must provide your own unique secret.
ADMIN_EMAIL=admin@civicpulse.gov
# ADMIN_PASSWORD=your_custom_secure_password_min_16_chars

# Server Port (Render dynamically assigns this):
PORT=8080

# CORS Allowed Origins (Comma-separated, supports wildcard patterns for Vercel):
CORS_ALLOWED_ORIGINS=https://civicpulse-governance.vercel.app,https://*.vercel.app,http://localhost:5173,http://localhost:3000

# Upload directory inside container:
UPLOAD_DIR=uploads

# ------------------------------------------------------------------------------
# Frontend Configuration (Set in Vercel Project Settings)
# ------------------------------------------------------------------------------
# Set this to your deployed Render backend URL (no trailing slash).
# In local development, leave empty to use Vite's built-in dev proxy.
VITE_API_BASE_URL=https://civicpulse-backend-pill.onrender.com
